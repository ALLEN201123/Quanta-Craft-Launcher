<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_download_package"
    android:visibility="gone"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <!-- ★ 1.5.2 D 方案：筛选栏可折叠（与模组页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toggle_package_filter"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_mod_ui_filter"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <!-- ★ 1.5.2：翻页栏（放在「筛选」右侧） -->
        <TextView
            android:id="@+id/package_page_prev"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_prev"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/package_page_info"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center"
            android:text="@string/download_page_first"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/package_page_next"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_next"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/download_package_filter_panel"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

        
                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/download_package_ui_source"/>
        
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/launcher_view_white">
        
                    <Spinner
                        android:layout_width="match_parent"
                        android:minWidth="80dp"
                        android:layout_height="match_parent"
                        android:id="@+id/download_package_arg_source"/>
        
                </RelativeLayout>
        
                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/download_package_ui_name"/>
        
                <EditText
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textSize="@dimen/text_size_middle"
                    android:hint="@string/download_package_ui_name_hint"
                    android:id="@+id/download_package_arg_name"/>
                    android:background="@drawable/launcher_view_white"/>
        
                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/download_package_ui_type"/>
        
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/launcher_view_white">
        
                    <Spinner
                        android:layout_width="match_parent"
                        android:minWidth="80dp"
                        android:layout_height="match_parent"
                        android:id="@+id/download_package_arg_type"/>
        
                </RelativeLayout>
        
                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/download_package_ui_version"/>
        
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/launcher_view_white">
        
                    <Spinner
                        android:layout_width="match_parent"
                        android:minWidth="80dp"
                        android:layout_height="match_parent"
                        android:id="@+id/download_package_arg_version"/>
        
                </RelativeLayout>
        
                <EditText
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textSize="@dimen/text_size_middle"
                    android:hint="@string/download_package_ui_version"
                    android:id="@+id/edit_download_package_arg_version"/>
                    android:background="@drawable/launcher_view_white"/>
        
                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/download_package_ui_sort"/>
        
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/launcher_view_white">
        
                    <Spinner
                        android:layout_width="match_parent"
                        android:minWidth="80dp"
                        android:layout_height="match_parent"
                        android:id="@+id/download_package_arg_sort"/>
        
                </RelativeLayout>
        
                <!-- ★ 1.5.5：从下载页导入整合包（竖排改造时保留，Java 的 onClick 引用了它） -->
                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:tag="tint_accent_color"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_button_transparent"
                    android:text="@string/download_package_ui_install"
                    android:textColor="@color/colorPureWhite"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/install_package_from_download_page"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
        
                    <Button
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:tag="tint_accent_color"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_button_transparent"
                        android:text="@string/download_package_ui_search"
                        android:textColor="@color/colorPureWhite"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/search_package"/>
        
                    <Button
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:tag="tint_accent_color"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_button_transparent"
                        android:text="@string/download_mod_ui_translation"
                        android:textColor="@color/colorPureWhite"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/translation_package_search"/>
        
                    <Button
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:tag="tint_accent_color"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_button_transparent"
                        android:text="@string/download_mod_ui_refresh"
                        android:textColor="@color/colorPureWhite"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/refresh_package_search"/>
        
                </LinearLayout>
        
                </LinearLayout>

            </ScrollView>
        </LinearLayout>

    <RelativeLayout
        android:layout_marginStart="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">

        <ListView
            android:divider="@color/colorTransparent"
            android:dividerHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/download_package_list"/>

        <ProgressBar
            android:tag="tint_accent_color"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:id="@+id/loading_download_package_list_progress"/>


    </RelativeLayout>

    </LinearLayout>   <!-- /左右分栏容器 -->

</LinearLayout>