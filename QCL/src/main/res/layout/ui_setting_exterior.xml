<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ui_setting_exterior"
    android:visibility="gone"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <TextView
                android:singleLine="true"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exterior_setting_ui_theme_title"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"/>
            
            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/launcher_view_light_gray">

                <LinearLayout
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_theme"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"
                        android:layout_gravity="center"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- ★★★ 1.5.0 用户要求：主题色入口改成**下拉框**（原来是"色块+十六进制"小按钮）。
                         点开列出预设配色，选一个即可全局应用。
                         ★ id 保留 select_theme（ExteriorSettingUI.onClick 里按它分叉），
                           改为 Spinner 后由 OnItemSelectedListener 处理选择。 -->
                    <Spinner
                        android:id="@+id/select_theme"
                        android:layout_width="130dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/launcher_button_gray"
                        android:spinnerMode="dropdown"/>

                    <!-- ★ 1.5.2 新增：**重置主题色**（玩家换过颜色后一键回默认） -->
                    <TextView
                        android:id="@+id/reset_theme_color"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/launcher_button_gray"
                        android:text="@string/exterior_setting_ui_reset"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_small"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_panel_color"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"
                        android:layout_gravity="center"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <LinearLayout
                        android:id="@+id/select_panel_color"
                        android:padding="6dp"
                        android:layout_width="120dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/launcher_button_gray"
                        android:orientation="horizontal">

                        <View
                            android:layout_marginStart="6dp"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:id="@+id/panel_color_view"/>

                        <TextView
                            android:singleLine="true"
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:id="@+id/panel_color_text"
                            android:textColor="#FFFFFFFF"
                            android:background="#80000000"
                            android:textSize="@dimen/text_size_small"
                            android:gravity="center"/>

                    </LinearLayout>

                    <!-- ★ 1.5.2 新增：**重置面板（背景板）色**（用户要求：换了颜色要能一键回默认） -->
                    <TextView
                        android:id="@+id/reset_panel_color"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/launcher_button_gray"
                        android:text="@string/exterior_setting_ui_font_color_reset"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_small"/>

                </LinearLayout>

                <!-- ★★★ 1.5.0 用户要求：下拉框**下面显示两个自定义色块**
                     （主题色色块 + 面板色色块）。点任一个 → 打开调色板自定义。 -->
                <LinearLayout
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/custom_theme_block"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/launcher_button_gray">

                        <View
                            android:id="@+id/theme_color_view"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="4dp"/>

                        <TextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/theme_color_text"
                            android:textColor="#FFFFFFFF"
                            android:background="#80000000"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:textSize="@dimen/text_size_small"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/custom_panel_block"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/launcher_button_gray">

                        <View
                            android:id="@+id/panel_color_block_view"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="4dp"/>

                        <TextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/panel_color_block_text"
                            android:textColor="#FFFFFFFF"
                            android:background="#80000000"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:textSize="@dimen/text_size_small"
                            android:gravity="center"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ★★★★★ 2026-10-16 新增：**字体颜色自定义调节**
                     （用户要求「在外观那里加一个字体颜色自定义调节功能」）。
                     点左侧色块 → 打开调色板选颜色 → 全局正文文字立刻变色；
                     右侧「跟随主题」按钮清空设置、回到日间黑字/夜间白字。 -->
                <LinearLayout
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exterior_setting_ui_font_color"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exterior_setting_ui_font_color_hint"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="@color/colorLightWhite"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/select_font_color"
                        android:padding="6dp"
                        android:layout_width="110dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/launcher_button_gray"
                        android:orientation="horizontal">

                        <View
                            android:layout_marginStart="6dp"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:id="@+id/font_color_view"/>

                        <TextView
                            android:singleLine="true"
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:id="@+id/font_color_text"
                            android:textColor="#FFFFFFFF"
                            android:background="#80000000"
                            android:textSize="@dimen/text_size_small"
                            android:gravity="center"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/reset_font_color"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:textSize="@dimen/text_size_small"
                        android:text="@string/exterior_setting_ui_font_color_reset"
                        android:background="@drawable/launcher_button_gray"
                        android:textColor="@color/colorPureBlack"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/colorDarkGray"/>

                <!-- ★★★ 1.5.0：**排版选择（旧排版 / 新排版）** —— 就放在原来「草方块 UI」开关的位置，
                     把那个已经下线的开关顶掉。
                     ★ 两套布局的 id 完全相同（27 个），同一时刻只能挂一套，
                       所以切换必须重启启动器才生效（见 MainActivity.inflateMainUi()），
                       Java 侧选完会 Toast 提示「重启后生效」。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_layout_style"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:singleLine="true"
                            android:tag="tint_accent_color"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exterior_setting_ui_layout_old"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"
                            android:id="@+id/select_layout_old"/>

                        <RadioButton
                            android:singleLine="true"
                            android:tag="tint_accent_color"
                            android:layout_margin="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exterior_setting_ui_layout_new"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"
                            android:id="@+id/select_layout_new"/>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/colorDarkGray"/>

                <!-- 1.3.7 新增：主界面是否显示账号人物（默认开） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_show_account_model"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"
                        android:layout_gravity="center"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:tag="tint_accent_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/switch_show_account_model"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/colorDarkGray"/>

                <!-- ★★★ 1.5.0：3D 人物的**动作**选择（用户：「只有走路动作，能不能添加更多」）。
                     · 只在「显示人物模型」打开时才有意义 → Java 侧会跟着显隐这整行。
                     · 5 个动作：站立 / 走路 / 跑步 / 旋转 / 挥手。
                     · 用 Spinner（与主题色下拉同款，工程里已有 ThemeColorSpinnerAdapter 那套写法）。 -->
                <LinearLayout
                    android:id="@+id/account_model_anim_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_account_model_anim"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"
                        android:layout_gravity="center"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <Spinner
                        android:id="@+id/spinner_account_model_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:entries="@array/account_model_anim_entries"
                        android:minWidth="120dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_transparent_bg"
                        android:textColor="@color/colorPureBlack"
                        android:textSize="@dimen/text_size_middle"
                        android:layout_gravity="center"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:tag="tint_accent_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/switch_transparent_bg"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/fullscreen_layout">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="@color/colorDarkGray"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="15dp">

                        <TextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exterior_setting_ui_full_screen"
                            android:textColor="@color/colorPureBlack"
                            android:textSize="@dimen/text_size_middle"
                            android:layout_gravity="center"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:tag="tint_accent_color"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switch_full_screen"
                            tools:ignore="UseSwitchCompatOrMaterialXml" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_marginTop="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exterior_setting_ui_bg_title"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"/>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/launcher_view_light_gray">

                <RadioButton
                    android:singleLine="true"
                    android:tag="tint_accent_color"
                    android:layout_margin="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exterior_setting_ui_bg_default"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:id="@+id/select_bg_default"/>

                <RadioButton
                    android:singleLine="true"
                    android:tag="tint_accent_color"
                    android:layout_margin="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exterior_setting_ui_bg_classic"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:id="@+id/select_bg_classic"/>

                <!-- ★ 1.5.0 新增：白天背景（固定显示白天图）。与「黑夜」成对，
                     上面「默认」则按现实时间在两者之间自动切换。 -->
                <RadioButton
                    android:singleLine="true"
                    android:tag="tint_accent_color"
                    android:layout_margin="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exterior_setting_ui_bg_day"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:id="@+id/select_bg_day"/>

                <LinearLayout
                    android:layout_margin="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:singleLine="true"
                        android:tag="tint_accent_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_bg_custom"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:id="@+id/select_bg_custom"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <EditText
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="140dp"
                        android:layout_height="32dp"
                        android:id="@+id/edit_bg_path"
                        android:background="@color/colorLightGray"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="@dimen/text_size_middle"/>

                    <ImageButton
                        android:layout_marginStart="15dp"
                        android:layout_gravity="center"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/ic_baseline_folder_black"
                        android:id="@+id/select_bg_path"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_margin="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:singleLine="true"
                        android:tag="tint_accent_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exterior_setting_ui_bg_online"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:id="@+id/select_bg_online"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <EditText
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="140dp"
                        android:layout_height="32dp"
                        android:id="@+id/edit_bg_url"
                        android:background="@color/colorLightGray"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="@dimen/text_size_middle"/>

                </LinearLayout>

                <!-- ★★★★★ 1.5.2 新增：**启动等待界面图片**（6 格，可单独换）。
                     ★★★ 自适应要点（用户特别提醒「别忘记加自适应，不然图片过大超出屏幕」）：
                       · 每格 layout_width=0dp + layout_weight=1 ⇒ 6 格**等分屏宽**，永不超屏；
                       · layout_height 固定 46dp ⇒ **绝不按图片原始尺寸撑高**；
                       · scaleType=centerCrop ⇒ 裁切填充，不变形不溢出；
                       · ImageView 不设 adjustViewBounds（默认 false），防止按宽高比外扩。 -->
                <LinearLayout
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wait_bg_0"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/wait_bg_slot_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/launcher_button_gray"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:id="@+id/wait_bg_1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/wait_bg_slot_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/launcher_button_gray"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:id="@+id/wait_bg_2"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/wait_bg_slot_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/launcher_button_gray"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:id="@+id/wait_bg_3"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/wait_bg_slot_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/launcher_button_gray"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:id="@+id/wait_bg_4"
