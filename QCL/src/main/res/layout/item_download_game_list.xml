<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★★★ 1.5.2 重做：游戏版本列表项改成**单行紧凑**。
     用户反馈：「手机一般都是 2800×1260……手机最多也只能看到两三个，
                 只有平板看到的比较多，怎么整才能让普通手机也能看到很多版本列表」。

     ★ 实测原因：该机 2800×1260 像素、density≈4 ⇒ 逻辑尺寸约 **700×315dp**，
       高度只有 315dp。原来每项 = 上下 padding 24dp + 图标 30dp ≈ **54dp**，
       扣掉标题栏/筛选行后列表区只剩 ~200dp ⇒ 只能显示 3~4 个。
     ⇒ 现在压成**单行**（图标 18dp + 三列文字同排），高度约 **30dp**，同屏可见数翻倍。

     ★ 自适应：全用 dp/sp；文字 singleLine + ellipsize，窄屏自动省略，不会撑高行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:clickable="true"
    android:focusable="true"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/launcher_button_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        android:src="@drawable/ic_grass"
        android:layout_gravity="center_vertical"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/id"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="@color/colorPureBlack" />

    <TextView
        android:id="@+id/type"
        android:tag="text_primary_color"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="10sp"
        android:textColor="@color/colorAccent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/release_time"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textSize="10sp"
        android:textColor="@color/colorLightWhite" />

    <!-- ★★★ 2026-10-25（1.5.5）：跳转该版本对应的 Minecraft Wiki 页。
         照 FCL 的 item_remote_version.xml（@+id/wiki，ic_baseline_earth_24）。
         点它只开浏览器，不触发整行的「进入安装页」——两件事必须分开，
         否则玩家想看 Wiki 却直接跳进了下载流程。 -->
    <ImageView
        android:id="@+id/wiki"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_baseline_earth_black"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/wiki_jump_desc" />

</LinearLayout>
