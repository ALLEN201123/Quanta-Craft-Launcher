<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ 1.5.0 新排版：**右侧常驻栏**（从 ui_main_new.xml 抽出，提到 activity_main 顶层）。

     ★ 为什么要抽出来：用户要求「整体对照 FCL」——
       FCL 的 right_menu（账号 + 启动按钮）是**常驻**的，切到二级页面时也不消失，
       玩家在版本列表 / 下载页也能看到当前账号和版本、随时能启动。

     ★★★ 本布局**只在新排版下 inflate**（旧排版完全不动）。

     ★★★★ 1.5.0 重做（用户原话：
       「账户显示在中间，版本显示在启动游戏按钮上方，大小和启动游戏一样，
         头像和账户也要弄成和启动游戏的一样，就是看起来一样」）——

       FCL 的版式（activity_main.xml @id/right_menu_content）：
         · @id/account 上下都被约束（top→progress、bottom→start）⇒ 在剩余空间里**自动居中**
         · @id/start   最底部，内部「启动游戏」+「[图标] 版本名」
         · 整个右栏宽 = 屏幕 25%（app:layout_constraintWidth_percent="0.25"）

       本文件的版式（**自下而上贴底，账号垂直居中**）：
         ┌───────────────────────────────┐
         │                               │
         │        头像 64dp（悬浮、无底板）      │  ← @id/start_ui_account
         │        账号名 16sp bold              │     上下约束 ⇒ **垂直居中**
         │        账号提示 12sp                 │     （top→parent，bottom→版本行顶部）
         │                               │
         ├───────────────────────────────┤
         │ ┌───────────────────────────┐ │  ← @id/launch_version_row
         │ │   [22dp图标]  版本名（居中）    │ │     **独立一块，在启动按钮上方**
         │ └───────────────────────────┘ │     与按钮**同宽同高**（都是通栏 match_parent）
         │ ┌───────────────────────────┐ │  ← @id/launcher_play_button
         │ │         启动游戏 (bold)        │ │     只剩一行文字（版本名已移出去）
         │ └───────────────────────────┘ │
         └───────────────────────────────┘

       ★ 为什么根节点可以用 ConstraintLayout：`R.id.new_right_panel` **Java 侧零引用**
         （MainActivity 只用 `new_right_panel_host`，类型是 View）⇒ 根节点类型随便改。
       ★★★ 但**子节点必须是 LinearLayout**：MainUI 里
           `private LinearLayout startAccountUI / startGame / launchVersionRow;`
         findViewById 泛型推断会强转 ⇒ 换成别的容器类型会 ClassCastException（启动崩溃）。

       ★ 为什么不需要底板？FCL 有 ThemeEngine：`app:use_theme_color="true"` 让文字色
         自动取当前主题算出的高对比色。QCL 没有这套引擎
         ⇒ 用 QCL 自己的**昼夜成对翻转色** `qcl_nav_text_primary/secondary`（日间近黑 / 夜间纯白）。

       ★ 保留项：头像两个 ImageView（face + hat）尺寸/位置必须完全一致 ——
         `Avatar.setAvatar` 是按 `imageView.getWidth()` 缩放后叠加的，差一点帽子就歪。
       ★ 保留项：所有资源 id 一律不变（Java 侧 `findViewById` 全部依赖它们）。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_right_panel"
    android:layout_width="@dimen/qcl_right_panel_width"
    android:layout_height="match_parent"
    android:paddingBottom="16dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- ==================== 账号区（照 FCL @id/account） ====================
         ★★★ 垂直居中：top→parent、bottom→版本行顶部 ⇒ 在「顶部 ~ 版本行」之间居中，
             既满足用户「账户显示在中间」，又天然不会和底部的版本行/启动按钮重叠。
         ★ 无底板（FCL 是 selectableItemBackgroundBorderless = 全透明），
           文字靠 qcl_nav_text_primary/secondary 的昼夜翻转保证可读。 -->
    <LinearLayout
        android:id="@+id/start_ui_account"
        android:focusable="true"
        android:clickable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/launch_version_row">

        <!-- ★ 头像放大到 64dp（用户要求「头像和账户也要弄成和启动游戏的一样，就是看起来一样」：
             原来 52dp 贴在 210dp 宽的右栏里显小，和通栏的启动按钮不成比例）。 -->
        <RelativeLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal">

            <!-- ★★★ 头像两个 ImageView **必须同尺寸、同位置（都靠左上，不加 centerInParent）**：
                 Avatar.setAvatar / setAvatarFromSkin 是按 imageView.getWidth() 缩放后
                 再叠加的（hat 盖在 face 上），尺寸或对齐只要差一点，帽子就会偏。 -->
            <ImageView
                android:id="@+id/account_skin_face"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_steve"/>

            <ImageView
                android:id="@+id/account_skin_hat"
                android:layout_width="64dp"
                android:layout_height="64dp"/>

        </RelativeLayout>

        <TextView
            android:singleLine="true"
            android:id="@+id/account_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/launcher_scroll_account_name"
            android:textColor="@color/qcl_nav_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:singleLine="true"
            android:id="@+id/account_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="@string/launcher_scroll_account_state"
            android:textColor="@color/qcl_nav_text_secondary"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- ==================== 版本行（独立一块，在启动按钮**上方**） ====================
         ★★★ 用户要求：「版本显示在启动游戏按钮上方，大小和启动游戏一样」——
             所以它**不是**画在按钮内部（上一版的做法），而是**与按钮同宽同高的独立一块**：
             两者都用 qcl_launch_block_bg（同款圆角 ripple）+ 同样的上下 padding ⇒ 大小完全一致。
         ★ 点这一行 → 进版本列表（MainUI 里 launchVersionRow 的监听）。 -->
    <LinearLayout
        android:id="@+id/launch_version_row"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/qcl_launch_block_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/launcher_play_button">

        <!-- ★ 图标尺寸照 FCL 的 @id/icon = 30dp（上一版写 18dp、22dp 都偏小） -->
        <ImageView
            android:id="@+id/launch_version_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_grass"/>

        <TextView
            android:id="@+id/launch_version_text"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:text="@string/launcher_button_current_version"
            android:textSize="14sp"
            android:textColor="@color/qcl_nav_text_primary"/>

    </LinearLayout>

    <!-- ==================== 启动按钮（贴底） ====================
         ★ 版本名已经**移到上方独立一行**，这里只剩「启动游戏」一行 ⇒ 高度与版本行一致（同款 padding）。
         ★ 整块可点 = 启动游戏（MainUI 里 startGame 的监听）。 -->
    <LinearLayout
        android:id="@+id/launcher_play_button"
        android:tag="tint_accent_color"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/qcl_launch_block_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:singleLine="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/launcher_button_launch"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/qcl_nav_text_primary"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
