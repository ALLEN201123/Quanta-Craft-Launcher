<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ 1.5.0 新排版：**右侧常驻栏**（从 ui_main_new.xml 抽出，提到 activity_main 顶层）。

     ★ 为什么要抽出来：用户要求「整体对照 FCL」——
       FCL 的 right_menu（账号 + 启动按钮）是**常驻**的，切到二级页面时也不消失，
       玩家在版本列表 / 下载页也能看到当前账号和版本、随时能启动。

     ★★★ 本布局**只在新排版下 inflate**（旧排版完全不动）。

     ★★★★ 1.5.0 重做（用户原话：「启动游戏上面的版本和账户也按照 fcl 的，不然看起来有点太难看」）——
       上一版我自己加了两块「半透明圆角卡片」（账号卡片 + 独立版本行），FCL 根本**不是**这样画的，
       叠在壁纸上确实很难看。现改为**逐条照 FCL 的 activity_main.xml**：

         FCL 版式（自下而上，整体贴右下角）：
           ┌─────────────────────────────┐
           │        头像 52dp（悬浮、无底板）      │  @id/account
           │        账号名 16sp bold              │   （selectableItemBackgroundBorderless，
           │        账号提示 12sp                 │     全透明，靠壁纸本身够暗/够亮）
           ├─────────────────────────────┤
           │ ┌─────────────────────────┐ │  @id/start
           │ │        启动游戏 (bold)        │ │   ← **版本名就在这个按钮里面**
           │ │   [30dp图标] 版本名           │ │      下半行是「[图标] 版本名」
           │ └─────────────────────────┘ │
           └─────────────────────────────┘

       ★ FCL 为什么不需要底板？因为它有 ThemeEngine：`app:use_theme_color="true"` 会让
         文字色**自动取当前主题算出的高对比色**（FCLTextView.refreshTheme →
         `ThemeEngine.getTheme().getColor2()`）。QCL 没有这套引擎
         ⇒ 改用 QCL 自己的**昼夜成对翻转色** `qcl_nav_text_primary/secondary`
           （日间近黑 / 夜间纯白），效果等价。

       ★ 保留项：头像左右两块 ImageView（face + hat）尺寸/位置必须完全一致 ——
         `Avatar.setAvatar` 是按 `imageView.getWidth()` 缩放后叠加的，差一点帽子就歪。
       ★ 保留项：所有资源 id 一律不变（Java 侧 `findViewById` 全部依赖它们）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_right_panel"
    android:layout_width="@dimen/qcl_right_panel_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="end|bottom"
    android:paddingBottom="16dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- ==================== 账号区（照 FCL @id/account） ==================== -->
    <!-- ★ 无底板（FCL 是 selectableItemBackgroundBorderless = 全透明）：
         上一版我加的 qcl_nav_panel_card 圆角卡片已**撤掉**（用户嫌难看）。
         文字靠 qcl_nav_text_primary/secondary 的昼夜翻转保证可读。 -->
    <LinearLayout
        android:id="@+id/start_ui_account"
        android:focusable="true"
        android:clickable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal">

            <!-- ★★★ 头像两个 ImageView **必须同尺寸、同位置（都靠左上，不加 centerInParent）**：
                 Avatar.setAvatar / setAvatarFromSkin 是按 imageView.getWidth() 缩放后
                 再叠加的（hat 盖在 face 上），尺寸或对齐只要差一点，帽子就会偏。 -->
            <ImageView
                android:id="@+id/account_skin_face"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_steve"/>

            <ImageView
                android:id="@+id/account_skin_hat"
                android:layout_width="52dp"
                android:layout_height="52dp"/>

        </RelativeLayout>

        <TextView
            android:singleLine="true"
            android:id="@+id/account_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/launcher_scroll_account_name"
            android:textColor="@color/qcl_nav_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:singleLine="true"
            android:id="@+id/account_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="@string/launcher_scroll_account_state"
            android:textColor="@color/qcl_nav_text_secondary"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- ==================== 启动区块（照 FCL @id/start） ==================== -->
    <!-- ★★★ 关键差异（这才是 FCL 的样子）：
         版本名**不是单独一行**，而是**画在启动按钮的下半部分** ——
         上半是「启动游戏」，下半是「[30dp 版本图标] 版本名」。
         上一版我做成「独立版本行 + 独立启动按钮」两块钱，所以看着散、难看。

         ★ id 保留：launcher_play_button（整块可点 = 启动）、
           launch_version_row（那一行 = 点进版本列表）、launch_version_icon / launch_version_text。
           ⇒ Java 侧（MainUI）逻辑一行不用改。 -->
    <LinearLayout
        android:id="@+id/launcher_play_button"
        android:tag="tint_accent_color"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/qcl_launch_block_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 「启动游戏」（照 FCL @id/text_start：bold、居中） -->
        <TextView
            android:singleLine="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/launcher_button_launch"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/qcl_nav_text_primary"/>

        <!-- 下半行 = 「[版本图标] 版本名」（照 FCL @id/icon + @id/version_name）
             ★ 点这一行 → 进版本列表（MainUI 里 launchVersionRow 的监听）。
             ★ 用 LinearLayout 而不是 ConstraintLayout：这里不需要约束，水平排即可，
               而且 XML 更简单（FCL 用 ConstraintLayout 是为了跟 text_start 叠放，我们分开排）。 -->
        <LinearLayout
            android:id="@+id/launch_version_row"
            android:focusable="true"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ★ 图标尺寸照 FCL 的 @id/icon = 30dp（上一版我写 18dp，太小） -->
            <ImageView
                android:id="@+id/launch_version_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_grass"/>

            <TextView
                android:id="@+id/launch_version_text"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:maxWidth="140dp"
                android:text="@string/launcher_button_current_version"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/qcl_nav_text_secondary"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
