<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_install_forge_list"
    android:visibility="gone"
    android:background="@color/launcher_ui_background"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ★ 1.5.0：顶部「提示」条已移除（用户要求：太占地方，列表能多显示一条是一条）。
         注意列表容器原来写的是 layout_height="match_parent"，在竖向 LinearLayout 里会被
         提示条挤掉一截；现在改成 0dp + weight=1，真正吃满剩余空间。 -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:background="@drawable/launcher_view_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/forge_version_list" />

        <ProgressBar
            android:tag="tint_accent_color"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:id="@+id/loading_forge_list_progress"/>

        <TextView
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/colorLinkBlue"
            android:textSize="22sp"
            android:text="@string/no_available_version"
            android:id="@+id/back_to_install_ui_forge"/>

    </RelativeLayout>

</LinearLayout>