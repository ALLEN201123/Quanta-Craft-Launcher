<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ 1.5.0：版本列表页**照 FCL 的 page_version_list.xml 重做为左右分栏**（用户多次要求）。

     FCL 的版式（page_version_list.xml）：
       ┌──────────────┬─────────────────────────────────┐
       │  搜索框(30%)   │                                 │
       │  版本 ListView │      右侧内容区 (70%)            │
       │  [刷新][新建]  │                                 │
       └──────────────┴─────────────────────────────────┘

     QCL 原来是**上下结构**（顶排按钮横滑 → 下面整块 ListView），
     现在改为**左右结构**：
       · 左 30%：版本 ListView + 空列表提示 + 刷新按钮（贴左下）
       · 右 70%：操作按钮（添加游戏目录 / 下载新版本 / 安装整合包 / 全局设置）
                 + 游戏目录行（game_dir_row，Java 动态往里加目录按钮）

     ★★★ 铁律：**所有 Java 侧引用的 id 一个都不能少、不能改名** ——
       VersionListUI 里 findViewById 的有：
         game_dir_row / local_version_list / start_download_mc_ui /
         start_add_game_directory_ui / refresh_local_version_list /
         loading_local_version_progress / content_list_parent /
         start_ui_download_minecraft / start_install_package_ui / start_ui_global_setting
       ⇒ 本文件只是把它们**重新摆放**，id 与类型全部原样保留，Java 一行都不用改。
     ★ 根容器从 LinearLayout 换成 ConstraintLayout（为了 layout_constraintWidth_percent）；
       visibility="invisible" 必须保留（BaseUI 靠它控制显隐）。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="invisible"
    android:id="@+id/ui_version_list"
    android:background="@color/launcher_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <!-- ==================== 左 30%：版本列表 ==================== -->
    <LinearLayout
        android:id="@+id/version_list_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.3">

        <!-- 版本列表区（ListView + 空提示 + 加载圈，三者叠在一起） -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:id="@+id/loading_local_version_progress"/>

            <!-- 「还没有任何版本，点这里去下载」——ListView 为空时它铺满整个区域可点 -->
            <TextView
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/colorLinkBlue"
                android:textSize="23sp"
                android:text="@string/version_list_ui_none"
                android:id="@+id/start_download_mc_ui"/>

            <ListView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/qcl_dialog_gray"
                android:id="@+id/local_version_list"/>

        </RelativeLayout>

        <!-- 刷新（照 FCL：列表下方的独立按钮，不再塞进顶部横滑条） -->
        <LinearLayout
            android:background="@drawable/qcl_button_gray"
            android:focusable="true"
            android:clickable="true"
            android:id="@+id/refresh_local_version_list"
            android:layout_marginTop="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/ic_baseline_refresh_white"/>

            <TextView
                android:singleLine="true"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_list_ui_refresh"
                android:textSize="14sp"
                android:textColor="@color/colorPureWhite"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ==================== 右 70%：操作区 ==================== -->
    <LinearLayout
        android:id="@+id/version_list_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/version_list_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 顶排：操作按钮 + 游戏目录，从左到右排列，可左右滑动（QCL 原有风格，保留） -->
        <HorizontalScrollView
            android:background="@color/qcl_gray_translucent_bar"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- 1. 添加游戏目录 -->
                <LinearLayout
                    android:background="@drawable/qcl_button_gray"
                    android:focusable="true"
                    android:clickable="true"
                    android:id="@+id/start_add_game_directory_ui"
                    android:layout_marginEnd="6dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/ic_baseline_add_white"/>

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_list_ui_add_dir"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureWhite"/>

                </LinearLayout>

                <!-- 2. 下载新版本 -->
                <LinearLayout
                    android:background="@drawable/qcl_button_gray"
                    android:focusable="true"
                    android:clickable="true"
                    android:id="@+id/start_ui_download_minecraft"
                    android:layout_marginEnd="6dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/ic_baseline_add_white"/>

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_list_ui_download_new_version"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureWhite"/>

                </LinearLayout>

                <!-- 3. 安装整合包 -->
                <LinearLayout
                    android:background="@drawable/qcl_button_gray"
                    android:focusable="true"
                    android:clickable="true"
                    android:id="@+id/start_install_package_ui"
                    android:layout_marginEnd="6dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/ic_baseline_pack_white"/>

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_list_ui_install_package"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureWhite"/>

                </LinearLayout>

                <!-- 4. 全局设置 -->
                <LinearLayout
                    android:background="@drawable/qcl_button_gray"
                    android:focusable="true"
                    android:clickable="true"
                    android:id="@+id/start_ui_global_setting"
                    android:layout_marginEnd="6dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/ic_baseline_settings_white"/>

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_list_ui_global_setting"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureWhite"/>

                </LinearLayout>

                <!-- 5. 游戏目录（与上面按钮同一排；Java 动态往 game_dir_row 里加目录按钮） -->
                <LinearLayout
                    android:id="@+id/content_list_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/game_dir_row"/>

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
