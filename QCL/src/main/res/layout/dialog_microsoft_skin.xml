<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@color/qcl_dialog_night_bg">

    <!-- 上半部分：左人物 + 右操作区 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 左侧：3D 皮肤预览 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ms_skin_parent_view"/>

        <!-- 右侧：操作区（可滚动） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/microsoft_skin_model_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"/>

                <RadioGroup
                    android:id="@+id/ms_model_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/ms_model_classic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/microsoft_skin_model_classic"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureBlack"/>

                    <RadioButton
                        android:id="@+id/ms_model_slim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/microsoft_skin_model_slim"
                        android:textSize="14sp"
                        android:textColor="@color/colorPureBlack"/>
                </RadioGroup>

                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="@string/microsoft_skin_select"
                    android:textSize="14sp"
                    android:textColor="@color/qcl_dialog_btn_text"
                    android:background="@drawable/qcl_dialog_button"
                    android:id="@+id/ms_skin_select"/>

                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/microsoft_skin_reset"
                    android:textSize="14sp"
                    android:textColor="@color/qcl_dialog_btn_text"
                    android:background="@drawable/qcl_dialog_button"
                    android:id="@+id/ms_skin_reset"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/microsoft_cape_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:id="@+id/ms_cape_list_layout"/>

                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/microsoft_cape_hide"
                    android:textSize="14sp"
                    android:textColor="@color/qcl_dialog_btn_text"
                    android:background="@drawable/qcl_dialog_button"
                    android:id="@+id/ms_cape_hide"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 底部：进度条 + 关闭按钮（固定，不随滚动） -->
    <ProgressBar
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:tag="tint_accent_color"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:id="@+id/ms_skin_progress"/>

    <!-- ★★★ 1.5.0 用户要求：「微软账号这个只有取消，没有确定」
     ⇒ 底部改成横排两个：左「取消」右「确定」（与其它 QCL 对话框一致）。
     ★ 确定只是关闭对话框（真正生效的是上面「选择皮肤」按钮的上传动作），
       所以这里点确定直接 dismiss，与取消等价 —— 差别只是符合常规操作习惯。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:singleLine="true"
            android:textAllCaps="false"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dialog_negative"
            android:textSize="15sp"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button"
            android:id="@+id/ms_skin_negative"/>

        <Button
            android:singleLine="true"
            android:textAllCaps="false"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/microsoft_skin_upload"
            android:textSize="15sp"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button"
            android:id="@+id/ms_skin_positive"/>
    </LinearLayout>

</LinearLayout>
