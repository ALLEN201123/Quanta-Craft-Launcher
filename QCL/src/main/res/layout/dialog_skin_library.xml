<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ 1.4.1：皮肤库对话框（QCL 自研）
     背景 = launcher_view_white（→ @color/qcl_panel_gray #C8EDEDED），
     与 QCL 全项目面板统一（dialog_offline_skin / ui_download_* / ui_install_* 等 30+ 处同款）。
     ★ 不要再用 qcl_dialog_gray（皮肤库独有，曾导致观感与其它对话框不一致）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_view_white"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/skin_library_title"
        android:textColor="@color/colorPureBlack"
        android:textSize="@dimen/text_size_middle"
        android:textStyle="bold" />

    <!-- 搜索：玩家名 或 皮肤图片直链 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/sk_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/skin_library_search_hint"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@color/colorPureBlack"
            android:textSize="14sp" />

        <Button
            android:id="@+id/sk_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:text="@string/skin_library_search"
            android:textSize="13sp"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button" />
    </LinearLayout>

    <!-- 模型 / 收藏 / 本地文件 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/sk_slim_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skin_library_slim"
            android:textColor="@color/colorPureBlack"
            android:textSize="13sp" />

        <Button
            android:id="@+id/sk_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/skin_library_favorite"
            android:textSize="13sp"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button" />

        <Button
            android:id="@+id/sk_local_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/skin_library_local"
            android:textSize="13sp"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button" />
    </LinearLayout>

    <!-- 左：皮肤网格；右：预览 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sk_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/sk_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_view_white"
                android:contentDescription="@string/skin_library_title"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/sk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/skin_library_empty"
                android:textColor="@color/colorPureBlack"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：应用 / 取消 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sk_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/skin_library_apply"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button" />

        <Button
            android:id="@+id/sk_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/skin_library_cancel"
            android:textColor="@color/qcl_dialog_btn_text"
            android:background="@drawable/qcl_dialog_button" />
    </LinearLayout>

</LinearLayout>
