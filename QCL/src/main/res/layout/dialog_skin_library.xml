<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ 1.4.1：皮肤库对话框（QCL 自研） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2151922"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/skin_library_title"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 搜索：玩家名 或 皮肤图片直链 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/sk_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/skin_library_search_hint"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#88FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/sk_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="76dp"
            android:text="@string/skin_library_search"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 模型 / 收藏 / 本地文件 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/sk_slim_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skin_library_slim"
            android:textColor="#FFE8ECF3"
            android:textSize="13sp" />

        <Button
            android:id="@+id/sk_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/skin_library_favorite"
            android:textSize="13sp" />

        <Button
            android:id="@+id/sk_local_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/skin_library_local"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 左：皮肤网格；右：预览 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/sk_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/sk_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FF1B2029"
                android:contentDescription="@string/skin_library_title"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/sk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/skin_library_empty"
                android:textColor="#FF9AA6B8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：应用 / 取消 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sk_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/skin_library_apply" />

        <Button
            android:id="@+id/sk_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/skin_library_cancel" />
    </LinearLayout>

</LinearLayout>
