<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_download_mod"
    android:visibility="gone"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ★★★★★ 1.5.2 D 方案：筛选栏可折叠（左右分栏） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toggle_mod_filter"
            android:tag="tint_accent_color"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_mod_ui_filter"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- ★ 1.5.2：翻页栏（用户要求放在「筛选」右侧） -->
        <TextView
            android:id="@+id/mod_page_prev"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_prev"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/mod_page_info"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center"
            android:text="@string/download_page_first"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/mod_page_next"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_next"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/download_mod_filter_panel"
        android:visibility="gone"
        android:background="@drawable/launcher_view_light_gray"
        android:layout_width="0dp"
        android:layout_weight="11"
        android:layout_height="match_parent"
        android:padding="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                        android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_game"/>

                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_view_white">

                        <Spinner
                            android:layout_width="match_parent"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:id="@+id/download_mod_arg_game"/>

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                        android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_name"/>

                    <EditText
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="80dp"
                        android:layout_height="30dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:textSize="@dimen/text_size_middle"
                        android:hint="@string/download_mod_ui_name_hint"
                        android:id="@+id/download_mod_arg_name"
                        android:background="@drawable/launcher_view_white"/>

                </LinearLayout>

                <LinearLayout
                        android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_type"/>

                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_view_white">

                        <Spinner
                            android:layout_width="match_parent"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:id="@+id/download_mod_arg_type"/>

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_source"/>

                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_view_white">

                        <Spinner
                            android:layout_width="match_parent"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:id="@+id/download_mod_arg_source"/>

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_version"/>

                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_view_white">

                        <Spinner
                            android:stateListAnimator="@null"
                            android:layout_width="match_parent"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:id="@+id/download_mod_arg_version"/>

                        <EditText
                            android:singleLine="true"
                            android:background="@drawable/launcher_view_white"
                            android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:textSize="@dimen/text_size_middle"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:id="@+id/edit_download_mod_arg_version"/>

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:singleLine="true"
                        android:layout_gravity="center"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/download_mod_ui_sort"/>

                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:background="@drawable/launcher_view_white">

                        <Spinner
                            android:layout_width="match_parent"
                android:minWidth="80dp"
                            android:layout_height="match_parent"
                            android:id="@+id/download_mod_arg_sort"/>

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:tag="tint_accent_color"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/launcher_button_transparent"
                android:text="@string/download_mod_ui_search"
                android:textColor="@color/colorPureWhite"
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/search_mod"/>

                  <!-- ★★★ 2026-10-25（1.5.5）：「英文查询」入口（照 FCL 的 TranslationDialog）。
                       搜中文搜不到时，弹窗列出翻译表里的英文候选，点一条就把搜索词换掉。 -->
                      <Button
                          android:singleLine="true"
                          android:textAllCaps="false"
                          android:tag="tint_accent_color"
                          android:layout_marginStart="8dp"
                          android:layout_width="wrap_content"
                          android:layout_height="30dp"
                          android:background="@drawable/launcher_button_transparent"
                          android:text="@string/download_mod_ui_translation"
                          android:textColor="@color/colorPureWhite"
                          android:textSize="15sp"
                          android:gravity="center"
                          android:id="@+id/translation_mod_search"/>

<Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:tag="tint_accent_color"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/launcher_button_transparent"
                    android:text="@string/download_mod_ui_refresh"
                    android:textColor="@color/colorPureWhite"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/refresh_mod_search"/>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_marginStart="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="9">

        <ListView
            android:divider="@color/colorTransparent"
            android:dividerHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/download_mod_list"/>

        <ProgressBar
            android:tag="tint_accent_color"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:id="@+id/loading_download_mod_list_progress"/>


    </RelativeLayout>

    </LinearLayout>   <!-- /左右分栏容器 -->

</LinearLayout>