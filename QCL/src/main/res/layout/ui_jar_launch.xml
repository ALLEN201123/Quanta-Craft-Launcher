<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/launcher_ui_background"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/jar_launch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jar_launch_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorPureBlack"/>

    <TextView
        android:id="@+id/jar_launch_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:singleLine="false"
        android:textColor="@color/colorPureBlack"/>

    <!-- 控制台输出 -->
    <ScrollView
        android:id="@+id/jar_launch_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/launcher_view_white">

        <TextView
            android:id="@+id/jar_launch_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="10sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textColor="@color/colorPureBlack"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/jar_launch_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/jar_launch_stop"/>

        <Button
            android:id="@+id/jar_launch_exit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/jar_launch_exit"/>
    </LinearLayout>

</LinearLayout>
