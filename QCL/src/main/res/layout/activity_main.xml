<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/launcher_layout"
        android:background="@drawable/ic_background_classic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

        <!-- 顶部标题栏已按用户要求移除（合成台图标 + 「量子方块启动器」标题 + 右侧窗口按钮）。
             下方 ui_main 的六个入口按钮因此整体上移到原位置。 -->
        <RelativeLayout
            android:id="@+id/main_ui_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ★★★ 1.5.0：主界面改成「按设置选排版」，所以这里不再 include ui_main。
                 原因有两个：
                   ① `<include>` 是**编译期固定**的，没法按开关二选一；
                   ② 两套布局的 id 集合**完全相同**（27 个），同时挂进视图树会让
                      `findViewById` 只抓到第一个 → 点一套、动的是另一套（串页）。
                 所以这里只留一个空容器，由 `MainActivity.inflateMainUi()` 在初始化时
                 inflate `ui_main.xml`（旧排版）或 `ui_main_new.xml`（新排版）进去，
                 同一时刻树里只有一套，天然没有重复 id。 -->
            <FrameLayout
                android:id="@+id/main_ui_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_account"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_game_manager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_version_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_download"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_multiplayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_setting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- ★ 1.5.0：原「大厅」(ui_lobby) 已整体移除（用户："没有实际用处"）。
                 下面是保留的「实验室」。 -->
            <include
                layout="@layout/ui_lab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_mod_update"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_manage_datapack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_export_world"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_add_game_directory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_package"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_export_package_type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_export_package_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_export_package_file"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_game"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_forge_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- ★ 1.4.2：NeoForge 版本选择页（与 Forge 同级） -->
            <include
                layout="@layout/ui_install_neoforge_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_fabric_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_fabric_api_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_lite_loader_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_optifine_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_quilt_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                layout="@layout/ui_install_quilt_api_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </RelativeLayout>

    </LinearLayout>

    <!-- ★★★ 1.5.0 新排版专用：**左右两栏常驻层**（照 FCL 的 left_menu / right_menu）。
         ★ 只在「设置 → 外观 → 排版」选了**新排版**时由 MainActivity 把
           ui_main_new_left.xml / ui_main_new_right.xml inflate 进来；旧排版下这里是空的（GONE）。
         ★ 位置很讲究：**放在 launcher_layout 之后**（= RelativLayout 里层级更高，
           会盖住 main_ui_container 里那些全屏铺满的二级页面），这样切到版本列表 / 下载 /
           设置等任意页面时，左导航和右侧启动栏**都不会消失**（用户要求）。
         ★ 但必须在 qcl_back_bar **之前** —— 右上角那个悬浮返回栏仍要压在最上层。
         ★ 旧排版：两个 host 保持 GONE，行为和 1.4.9 完全一致。 -->
    <FrameLayout
        android:id="@+id/new_left_nav_host"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"/>

    <FrameLayout
        android:id="@+id/new_right_panel_host"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>

    <!-- 二级页面返回栏（1.0.6 新增）。
         顶部标题栏已整体移除，但二级页面（下载 / 版本列表 / 账户 / 设置 / 游戏管理等）
         仍需返回入口。这里用一层**悬浮**控件实现，不占布局空间、不引入标题栏：
         只在进入二级页面时由 showBarTitle() 点亮，主界面保持隐藏。
         放在 launcher_layout 之外，避免被 LinearLayout 垂直排版影响。 -->
    <LinearLayout
        android:id="@+id/qcl_back_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/qcl_back_bar_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageButton
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:id="@+id/back_to_last_ui"
            android:background="@drawable/ic_baseline_arrow_white"/>

        <ImageButton
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:scaleType="fitCenter"
            android:id="@+id/back_to_home"
            android:background="@drawable/ic_baseline_home_white"/>

        <TextView
            android:singleLine="true"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_middle"
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:id="@+id/text_current_ui"
            android:textColor="@color/colorPureWhite"/>

        <ImageButton
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:scaleType="fitCenter"
            android:id="@+id/close_current_ui"
            android:background="@drawable/ic_baseline_close_white"/>

    </LinearLayout>

    <Button
        android:id="@+id/fake_dialog_background"
        android:stateListAnimator="@null"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73252525"/>

    <include
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        layout="@layout/dialog_offline_skin"
        android:layout_centerHorizontal="true"
        android:layout_width="600dp"
        android:layout_height="match_parent"/>

</RelativeLayout>