<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_download_world"
    android:visibility="gone"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <!-- ★ 1.5.2 D 方案：筛选栏可折叠（与模组页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toggle_world_filter"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_mod_ui_filter"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <!-- ★ 1.5.2：翻页栏（放在「筛选」右侧） -->
        <TextView
            android:id="@+id/world_page_prev"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_prev"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/world_page_info"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center"
            android:text="@string/download_page_first"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>

        <TextView
            android:id="@+id/world_page_next"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/launcher_button_gray"
            android:text="@string/download_page_next"
            android:textColor="@color/colorPureBlack"
            android:textSize="@dimen/text_size_small"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/download_world_filter_panel"
            android:background="@drawable/launcher_view_light_gray"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:orientation="vertical">
        
            <TextView
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"
                android:text="@string/download_world_ui_name"/>
        
            <EditText
                android:singleLine="true"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textSize="@dimen/text_size_middle"
                android:hint="@string/download_world_ui_name"
                android:id="@+id/download_world_arg_name"/>
                android:background="@drawable/launcher_view_white"/>
        
            <TextView
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"
                android:text="@string/download_world_ui_type"/>
        
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/launcher_view_white">
        
                <Spinner
                    android:layout_width="match_parent"
                    android:minWidth="80dp"
                    android:layout_height="match_parent"
                    android:id="@+id/download_world_arg_type"/>
        
            </RelativeLayout>
        
            <TextView
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"
                android:text="@string/download_world_ui_version"/>
        
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/launcher_view_white">
        
                <Spinner
                    android:layout_width="match_parent"
                    android:minWidth="80dp"
                    android:layout_height="match_parent"
                    android:id="@+id/download_world_arg_version"/>
        
            </RelativeLayout>
        
            <EditText
                android:singleLine="true"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textSize="@dimen/text_size_middle"
                android:hint="@string/download_world_ui_version"
                android:id="@+id/edit_download_world_arg_version"/>
                android:background="@drawable/launcher_view_white"/>
        
            <TextView
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"
                android:text="@string/download_world_ui_sort"/>
        
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/launcher_view_white">
        
                <Spinner
                    android:layout_width="match_parent"
                    android:minWidth="80dp"
                    android:layout_height="match_parent"
                    android:id="@+id/download_world_arg_sort"/>
        
            </RelativeLayout>
        
            <TextView
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/colorPureBlack"
                android:text="@string/download_mod_ui_source"/>
        
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/launcher_view_white">
        
                <Spinner
                    android:layout_width="match_parent"
                    android:minWidth="80dp"
                    android:layout_height="match_parent"
                    android:id="@+id/download_world_arg_source"/>
        
            </RelativeLayout>
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
        
                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:tag="tint_accent_color"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="30dp"
                    android:background="@drawable/launcher_button_transparent"
                    android:text="@string/download_world_ui_search"
                    android:textColor="@color/colorPureWhite"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/search_world_list"/>
        
                <Button
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:tag="tint_accent_color"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="30dp"
                    android:background="@drawable/launcher_button_transparent"
                    android:text="@string/download_mod_ui_refresh"
                    android:textColor="@color/colorPureWhite"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/refresh_world_search"/>
        
            </LinearLayout>
        
        </LinearLayout>

    <RelativeLayout
        android:layout_marginStart="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">

        <ListView
            android:divider="@color/colorTransparent"
            android:dividerHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/download_world_list"/>

        <ProgressBar
            android:tag="tint_accent_color"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:id="@+id/loading_download_world_list_progress"/>


    </RelativeLayout>

    </LinearLayout>   <!-- /左右分栏容器 -->

</LinearLayout>