<?xml version="1.0" encoding="utf-8"?>
<!-- 草方块 UI · 次级面板：泥土贴图平铺（比草方块面板更素） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/qcl_dirt_tile"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape>
            <stroke android:width="2dp" android:color="#BB2E1B08" />
            <solid android:color="#00000000" />
            <corners
                android:topLeftRadius="4.0dip"
                android:topRightRadius="4.0dip"
                android:bottomLeftRadius="4.0dip"
                android:bottomRightRadius="4.0dip"/>
        </shape>
    </item>
</layer-list>
