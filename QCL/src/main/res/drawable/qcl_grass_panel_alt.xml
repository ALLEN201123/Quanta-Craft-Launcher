<?xml version="1.0" encoding="utf-8"?>
<!--
  草方块 UI · 次级面板（1.0.6 重构）
  与主面板的区别：不带草皮条，纯泥土平铺 —— 用于内容区/列表底色，
  避免整屏都是草，视觉上「草在面板顶、泥土在内容区」，层次更清楚。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/qcl_dirt_tile"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape>
            <stroke android:width="2dp" android:color="#BB2E1B08" />
            <solid android:color="#00000000" />
            <corners
                android:topLeftRadius="4.0dip"
                android:topRightRadius="4.0dip"
                android:bottomLeftRadius="4.0dip"
                android:bottomRightRadius="4.0dip"/>
        </shape>
    </item>
</layer-list>
