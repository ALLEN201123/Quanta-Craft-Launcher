<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.qcl.launcher">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE" />

    
    <!-- ★ Android 11+ 包可见性：外部渲染器（如 MobileGlues / VGPU 插件）通过
         「已安装应用的 nativeLibraryDir」提供 so，需要能查询到这些带启动图标的应用。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
<application
        android:name=".launcher.QCLApplication"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:icon="@drawable/ic_craft_table"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_craft_table"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:hasFragileUserData="true"
        android:allowNativeHeapPointerTagging="false"
        android:isGame="true"
        android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"
        tools:targetApi="32">
        <!--
          ★★★ 2026-09-17：应用启动入口由旧的 SplashActivity 改为「安装或更新运行环境」页。
          旧的 SplashActivity（三行标题 + 一条进度条、玩家看不见在装什么）已删除，
          它原本的「申请权限 → 初始化 → 解压基础文件」职责全部并入本页。
          现在打开 QCL 第一个看到的就是这个列表页：
            八项运行环境全部就绪 → 自动跳主界面（玩家看不到这一页）；
            有任何缺项        → 停在这一页，玩家点「安装 / 更新」。
          与 FCL 一致（FCL 是在主界面里挂 RuntimeFragment 做同样的事）。
        -->
        <activity
            android:name=".launcher.setting.RuntimeInstallActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:exported="true"
            android:name=".control.ImportControlActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition">
            <intent-filter
                android:scheme="content"
                android:label="@string/import_control_label"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".launcher.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".auth.microsoft.MicrosoftLoginActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".control.ControlPatternActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".launcher.launch.ExitActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:launchMode="standard"
            android:multiprocess="true"
            android:name=".launcher.launch.boat.BoatMinecraftActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|orientation|screenLayout|uiMode|screenSize|navigation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:launchMode="standard"
            android:multiprocess="true"
            android:name=".launcher.launch.pojav.PojavMinecraftActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <service
            android:name=".launcher.launch.boat.VirGLService"
            android:process=":virGLProcess"
            android:enabled="true"
            android:exported="true" />
        <service
            android:name=".launcher.download.ApiService"
            android:process=":apiService"
            android:enabled="true"
            android:exported="true" />
        <service
            android:name=".multiplayer.Hin2nService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    
        <service
            android:name=".launcher.terracotta.TerracottaVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>


        <activity
            android:name=".launcher.CrashReportActivity"
            android:screenOrientation="landscape"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true" />

        </application>

</manifest>
