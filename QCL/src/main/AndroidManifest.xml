<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.qcl.launcher">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
        <!-- ★ 2026-10-06：Android 14+ 起前台服务必须声明具体类型对应的权限，
             否则 startForeground() 会被系统拒绝，保活失效。 -->
        <uses-permission
            android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE" />

    
    <!-- ★ Android 11+ 包可见性：外部渲染器（如 MobileGlues / VGPU 插件）通过
         「已安装应用的 nativeLibraryDir」提供 so，需要能查询到这些带启动图标的应用。 -->
    <queries>
        <!-- ★★★ 1.4.9：外部渲染器插件（RendererPlugin v1/v2 协议）。
             Android 11+ 包可见性限制下，不显式声明就 getInstalledApplications() 读不到它们，
             导致 RendererPlugin.plugins() 返回空 → 插件声明的 pojavEnv 全部不注入
             → MobileGlues 拿不到 LIBGL_ES=3 / MG_COUNT_LAUNCH，26.3 渲染管线崩。
             QUERY_ALL_PACKAGES 覆盖所有未知插件（Zalith/FCL 生态的渲染器不止 mg 一个）。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <package android:name="com.fcl.plugin.mobileglues" />
        <package android:name="com.movtery.zalithlauncher.v2" />
        <package android:name="com.movtery.zalithlauncher.v2.debug" />
        <package android:name="com.tungsten.fcl" />
        <package android:name="com.fcl.plugin.krypton" />
        <!-- ★ 1.1.4：vivo/iQOO「游戏魔盒」。Android 11+ 的包可见性限制下，
             不声明就 getLaunchIntentForPackage("com.vivo.gamecube") 会返回 null。 -->
        <package android:name="com.vivo.gamecube" />
    </queries>
<application
        android:name=".launcher.QCLApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:icon="@drawable/ic_command_block"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_command_block"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:hasFragileUserData="true"
        android:allowNativeHeapPointerTagging="false"
        android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"
        tools:targetApi="32">
        <!--
          ★★★ 2026-09-17：应用启动入口由旧的 SplashActivity 改为「安装或更新运行环境」页。
          旧的 SplashActivity（三行标题 + 一条进度条、玩家看不见在装什么）已删除，
          它原本的「申请权限 → 初始化 → 解压基础文件」职责全部并入本页。
          现在打开 QCL 第一个看到的就是这个列表页：
            八项运行环境全部就绪 → 自动跳主界面（玩家看不到这一页）；
            有任何缺项        → 停在这一页，玩家点「安装 / 更新」。
          与 FCL 一致（FCL 是在主界面里挂 RuntimeFragment 做同样的事）。
        -->
        <activity
            android:name=".launcher.setting.RuntimeInstallActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.QCL.Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:exported="true"
            android:name=".control.ImportControlActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition">
            <intent-filter
                android:scheme="content"
                android:label="@string/import_control_label"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".launcher.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".auth.microsoft.MicrosoftLoginActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".control.ControlPatternActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".launcher.launch.ExitActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:launchMode="standard"
            android:multiprocess="true"
            android:name=".launcher.launch.pojav.PojavMinecraftActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>

    <!-- 远古版本「加载文件…」用的游戏内文件浏览器（cacio 的 AWT 对话框在安卓上画不出来） -->
    <activity
        android:name=".launcher.launch.pojav.LevelFileChooserActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:screenOrientation="sensorLandscape"
        android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <!-- ★★★ 1.4.8：游戏运行期间的保活前台服务。
             修「切到后台几秒游戏就挂掉」：游戏 JVM 跑在本进程里，
             没有前台服务时切后台会被系统（尤其国产 ROM）很快回收。
             stopWithTask=false 让玩家划掉最近任务也不至于连带停掉它。

             ★ 2026-10-06 修复：补上 foregroundServiceType！
             从 Android 14（API 34）起，startForeground() 必须声明服务类型，
             否则抛 MissingForegroundServiceTypeException → 被 catch 吞掉
             → 保活服务**实际没生效**（用户反馈"切后台一段时间回来游戏就没了"）。
             这里用 specialUse（"其他用途"），并配上对应权限。 -->
        <service
            android:name=".launcher.launch.pojav.GameAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep Minecraft running while the player switches apps" />
        </service>

        <service
            android:name=".launcher.download.ApiService"
            android:process=":apiService"
            android:enabled="true"
            android:exported="true" />
    
        <service
            android:name=".launcher.terracotta.TerracottaVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>


        <activity
            android:name=".launcher.CrashReportActivity"
            android:screenOrientation="landscape"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true" />

        </application>

</manifest>
